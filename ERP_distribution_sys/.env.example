# ==============================================================================
# 環境變數設定範本 (請複製此檔案為 .env 並填入實際值，請勿將 .env 提交至 Git)
# ==============================================================================

# Supabase 設定 (選填：若未提供則系統自動降級為 In-Memory 記憶體模式)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Google Gemini API Key (可於 Google AI Studio 免費申請)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI 設定 (選填：若使用 OpenAI 解釋層)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Allocation Engine 服務埠號
PORT=4000

# FastAPI 後端呼叫分配引擎的端點位址
ENGINE_API_URL=http://localhost:4000/api/allocate

# 前端呼叫後端 API 位址 (若部署至 Vercel，請於 Vercel 環境變數中設定)
# VITE_BACKEND_URL=https://your-orchestrator-backend.onrender.com
